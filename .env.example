# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a key from: https://aistudio.google.com
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional APP_URL if needed.
APP_URL="MY_APP_URL"

# USER_NAME: Dynamic username used by the voice assistant
USER_NAME="Chiru"

# WAKE_WORD: Wake word used to trigger voice session activation
WAKE_WORD="nova"

# Optional LLM provider keys
OPENROUTER_API_KEY="your_openrouter_api_key"
GROQ_API_KEY="your_groq_api_key"

# Optional model overrides (free-tier friendly defaults are used when omitted)
OPENROUTER_CHAT_MODEL="openrouter/free"
OPENROUTER_CODE_MODEL="qwen/qwen3-coder:free"
OPENROUTER_ANALYSIS_MODEL="deepseek/deepseek-r1:free"
OPENROUTER_VISION_MODEL="google/gemini-2.0-flash-exp:free"
GROQ_CHAT_MODEL="llama-3.1-8b-instant"
GROQ_CODE_MODEL="qwen/qwen3-32b"
GROQ_ANALYSIS_MODEL="llama-3.3-70b-versatile"

# NanoClaw channel integrations
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_URL=""
DISCORD_BOT_TOKEN=""
DISCORD_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""
SLACK_VERIFICATION_TOKEN=""
SLACK_WEBHOOK_URL=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""
IMESSAGE_WEBHOOK_URL=""
MATRIX_WEBHOOK_URL=""
SIGNAL_WEBHOOK_URL=""
VIBER_WEBHOOK_URL=""
SMS_WEBHOOK_URL=""
EMAIL_WEBHOOK_URL=""
WEB_WEBHOOK_URL=""
