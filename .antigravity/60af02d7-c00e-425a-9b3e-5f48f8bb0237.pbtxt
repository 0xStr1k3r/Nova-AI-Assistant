    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import fs from \"fs\";\nimport path from \"path\";\n\nconst DB_PATH = path.join(process.cwd(), \"nexus-data.json\");\n\nexport interface Mode {\n  id: string;\n  name: string;\n  instruction: string;\n  isCustom: boolean;\n}\n\nexport interface NexusConfig {\n  wakeWord: string;\n  activeModeId: string;\n  modes: Mode[];\n  memory: string[];\n}\n\nconst defaultModes: Mode[] = [\n  {\n    id: \"normal\",\n    name: \"Normal Voice\",\n    instruction: \"You are a helpful AI voice assistant for Linux. You can answer questions and run safe, read-only system commands using the \'runLinuxCommand\' tool (like ls, top, free). Do NOT run destructive commands.\",\n    isCustom: false,\n  },\n  {\n    id: \"full\",\n    name: \"Full System Access\",\n    instruction: \"You are the Nexus OS System Core. You have FULL root-level access to the underlying Linux host. You can run ANY command requested by the user, including package installation, service restarts, and file modifications. Be bold but concise.\",\n    isCustom: false,\n  }\n];\n\nconst defaultConfig: NexusConfig = {\n  wakeWord: \"nexus\",\n  activeModeId: \"normal\",\n  modes: defaultModes,\n  memory: [],\n};\n\nexport function getDb(): NexusConfig {\n  if (fs.existsSync(DB_PATH)) {\n    try {\n      const data = fs.readFileSync(DB_PATH, \"utf-8\");\n      return JSON.parse(data) as NexusConfig;\n    } catch (e) {\n      console.error(\"Error reading db:\", e);\n      return defaultConfig;\n    }\n  }\n  return defaultConfig;\n}\n\nexport function saveDb(config: NexusConfig) {\n  fs.writeFileSync(DB_PATH, JSON.stringify(config, null, 2), \"utf-8\");\n}\n\nexport function addMemory(entry: string) {\n  const db = getDb();\n  db.memory.push(`[${new Date().toISOString()}] ${entry}`);\n  // Keep last 50 memories\n  if (db.memory.length > 50) {\n    db.memory.shift();\n  }\n  saveDb(db);\n}\n"
