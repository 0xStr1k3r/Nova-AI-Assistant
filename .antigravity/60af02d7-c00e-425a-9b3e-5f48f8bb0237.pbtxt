    replacement_chunks {
      target_content: "import React, { useState, useEffect, useRef } from \"react\";\nimport { Terminal, Mic, Square, ShieldAlert, Cpu, Activity, CircleOff } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { pcmToBase64 } from \"./utils/audio\";\nimport { AudioStreamer } from \"./utils/AudioStreamer\";\n\nexport default function App() {\n  const [isConnected, setIsConnected] = useState(false);\n  const [isConnecting, setIsConnecting] = useState(false);\n  const [logs, setLogs] = useState<string[]>([]);\n  \n  const wsRef = useRef<WebSocket | null>(null);"
      replacement_content: "import React, { useState, useEffect, useRef } from \"react\";\nimport { Terminal, Mic, Square, ShieldAlert, Cpu, Activity, CircleOff, Settings, MicOff } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { pcmToBase64 } from \"./utils/audio\";\nimport { AudioStreamer } from \"./utils/AudioStreamer\";\nimport SettingsModal from \"./components/SettingsModal\";\n\nexport default function App() {\n  const [isConnected, setIsConnected] = useState(false);\n  const [isConnecting, setIsConnecting] = useState(false);\n  const [logs, setLogs] = useState<string[]>([]);\n  \n  const [showSettings, setShowSettings] = useState(false);\n  const [config, setConfig] = useState<any>(null);\n  const [isWakeWordListening, setIsWakeWordListening] = useState(false);\n\n  const wsRef = useRef<WebSocket | null>(null);"
    }
    replacement_chunks {
      target_content: "  useEffect(() => {\n    if (logsEndRef.current) {\n      logsEndRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [logs]);\n\n  const connect = async () => {"
      replacement_content: "  useEffect(() => {\n    if (logsEndRef.current) {\n      logsEndRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [logs]);\n\n  useEffect(() => {\n    fetch(\"/api/config\").then(r => r.json()).then(setConfig);\n  }, []);\n\n  const recognitionRef = useRef<any>(null);\n\n  const toggleWakeWord = () => {\n    if (!(\"webkitSpeechRecognition\" in window)) {\n      addLog(\"ERROR: Speech recognition not supported in this browser.\");\n      return;\n    }\n\n    if (isWakeWordListening) {\n      if (recognitionRef.current) {\n        recognitionRef.current.stop();\n        recognitionRef.current = null;\n      }\n      setIsWakeWordListening(false);\n      addLog(\"Wake word listening disabled.\");\n    } else {\n      const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n      const recognition = new SpeechRecognition();\n      recognition.continuous = true;\n      recognition.interimResults = false;\n      recognition.lang = \"en-US\";\n      \n      recognition.onresult = (event: any) => {\n         const last = event.results.length - 1;\n         const transcript = event.results[last][0].transcript.trim().toLowerCase();\n         // Check if config exists and wake word is in the transcript\n         if (config && config.wakeWord && transcript.includes(config.wakeWord.toLowerCase())) {\n            addLog(`Wake word \'${config.wakeWord}\' detected!`);\n            if (!isConnected && !isConnecting) {\n               connect(); // Open Live API\n            }\n         }\n      };\n\n      recognition.onerror = (e: any) => {\n         if (e.error !== \"no-speech\") addLog(`Wake word error: ${e.error}`);\n      };\n\n      recognition.onend = () => {\n         // Auto-restart to keep in background if still active\n         if (isWakeWordListening && recognitionRef.current) {\n            try { recognition.start(); } catch(e) {}\n         }\n      };\n\n      recognition.start();\n      recognitionRef.current = recognition;\n      setIsWakeWordListening(true);\n      addLog(`Wake word listening enabled for \'${config?.wakeWord}\'`);\n    }\n  };\n\n  const connect = async () => {"
    }
