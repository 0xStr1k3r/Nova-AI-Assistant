rounded-full\">\n              <span className=\"text-xs text-slate-300\">Live API Tunnel</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Main Content Grid */}\n        <div className=\"flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6 z-10 min-h-0\">\n          \n          {/* Sidebar: System Logs */}\n          <div className=\"lg:col-span-4 flex flex-col space-y-4\">\n            <div className=\"flex-1 bg-black/40 backdrop-blur-2xl border border-white/10 rounded-3xl p-6 flex flex-col min-h-0\">\n              <h2 className=\"text-xs font-bold text-slate-500 uppercase tracking-widest mb-4 flex justify-between items-center\">\n                <span>Event Horizon</span>\n                <ShieldAlert size={14} className=\"text-indigo-400\" />\n              </h2>\n              <div className=\"flex-1 overflow-y-auto space-y-4 scrollbar-thin text-sm font-mono pr-2 relative\">\n                {logs.length === 0 ? (\n                  <div className=\"flex flex-col items-center justify-center h-full text-slate-600 opacity-50 space-y-2\">\n                    <CircleOff size={24} />\n                    <span className=\"font-sans text-xs\">No events</span>\n                  </div>\n                ) : (\n                  logs.map((log, idx) => {\n                    const isError = log.includes(\"ERROR\") || log.includes(\"Failed\");\n                    const isSuccess = log.includes(\"Connected\") || log.includes(\"terminated\");\n                    return (\n                      <div key={idx} className=\"flex items-start space-x-3 group transition-opacity\">\n                        <div className={`w-1 h-8 rounded-full shrink-0 ${isError ? \"bg-red-500\" : isSuccess ? \"bg-emerald-400\" : \"bg-indigo-500\"}`}></div>\n                        <div className=\"min-w-0 flex-1\">\n                          <p className={`text-sm ${isError ? \"text-red-300\" : isSuccess ? \"text-emerald-200\" : \"text-slate-200\"}`}>{log}</p>\n                          <p className={`text-[10px] font-mono italic mt-0.5 ${isError ? \"text-red-500/70\" : isSuccess ? \"text-emerald-500/70\" : \"text-slate-500\"}`}>\n                            {isError ? \"Task failed\" : isSuccess ? \"State changed\" : \"Task received\"}\n                          </p>\n                        </div>\n                      </div>\n                    );\n                  })\n                )}\n                <div ref={logsEndRef} />\n              </div>\n              <div className=\"mt-4 p-4 bg-white/5 rounded-2xl border border-white/5 shrink-0\">\n                <p className=\"text-[10px] uppercase text-slate-500 tracking-tighter mb-1 font-bold\">Active Context</p>\n                <p className=\"text-xs text-slate-300\">Terminal {isConnected ? \"Session #421\" : \"Disconnected\"} \342\200\242 {isConnecting ? \"Connecting\" : \"Workspace 1\"}</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Main Visualizer Area */}\n          <div className=\"lg:col-span-8 flex flex-col space-y-6\">\n            \n            {/* AI Pulse Core */}\n            <div className=\"flex-1 bg-white/5 backdrop-blur-2xl border border-white/10 rounded-[2.5rem] flex flex-col items-center justify-center relative overflow-hidden\">\n              <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-indigo-500/5 via-transparent to-transparent pointer-events-none\"></div>\n              \n              <AnimatePresence>\n                {isConnected && (\n                  <motion.div\n                    initial={{ opacity: 0, scale: 0.8 }}\n                    animate={{ opacity: 1, scale: 1 }}\n                    exit={{ opacity: 0, scale: 0.8 }}\n                    className=\"absolute inset-0 flex items-center justify-center pointer-events-none\"\n                  >\n                    <div className=\"w-[300px] h-[300px] rounded-full bg-indigo-500/10 animate-pulse blur-3xl mix-blend-screen\" />\n                    <div className=\"w-[200px] h-[200px] rounded-full border border-indigo-400/20 absolute animate-[spin_10s_linear_infinite]\" />\n                    <div className=\"w-[150px] h-[150px] rounded-full border border-emerald-400/20 absolute animate-[spin_15s_linear_infinite_reverse]\" />\n                  </motion.div>\n                )}\n              </AnimatePresence>\n              \n              {/* The Orb wrapping the button */}\n              <div className=\"w-48 h-48 rounded-full flex items-center justify-center shrink-0 z-10 transition-all duration-500\">\n                <div className={`w-full h-full rounded-full flex items-center justify-center p-1 transition-all duration-700 ${isConnected ? \"bg-gradient-to-tr from-indigo-600 to-emerald-400\" : \"bg-white/10\"}`}>\n                  <div className=\"w-full h-full rounded-full bg-[#09090b] flex items-center justify-center\">\n                    <motion.button\n                      whileHover={{ scale: 1.05 }}\n                      whileTap={{ scale: 0.95 }}\n                      onClick={isConnected || isConnecting ? disconnect : connect}\n                      className={`\n                        w-32 h-32 rounded-full flex items-center justify-center transition-all duration-500\n                        ${isConnected ? \"bg-white/5 backdrop-blur-xl border border-white/10 shadow-[0_0_50px_-12px_rgba(79,70,229,0.5)] text-white\" : \n                          isConnecting ? \"bg-white/5 border border-yellow-500/30 text-yellow-500 animate-pulse\" : \n                          \"bg-white/5 text-slate-400 hover:text-white border border-white/10 hover:bg-white/10\"}\n                      `}\n                    >\n                      {isConnected ? (\n                        <Square size={36} fill=\"currentColor\" className=\"animate-pulse\" />\n                      ) : isConnecting ? (\n                        <Activity size={36} className=\"animate-spin\" />\n                      ) : (\n                        <Mic size={36} />\n                      )}\n                    </motion.button>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"mt-8 text-center z-10\">\n                <p className=\"text-2xl font-light text-slate-300\">\n                  {isConnected ? \"Listening for commands...\" : isConnecting ? \"Establishing uplink...\" : \"System Standby\"}\n                </p>\n                <p className={`text-sm mt-2 font-mono uppercase tracking-[0.2em] ${isConnected ? \"text-indigo-400\" : \"text-slate-500\"}`}>\n                  {isConnected ? \"Microphone active\" : \"Tap to connect\"}\n                </p>\n              </div>\n            </div>\n\n            {/* Live Status Bar */}\n            <div className=\"h-24 bg-white/5 backdrop-blur-3xl border border-white/10 rounded-3xl p-4 flex items-center space-x-4 shrink-0\">\n              <div className={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 transition-colors ${isConnected ? \"bg-indigo-500\" : \"bg-white/10\"}`}>\n                <Cpu size={24} className={isConnected ? \"text-white\" : \"text-slate-500\"} />\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"h-1 bg-white/10 rounded-full w-full mb-2 overflow-hidden\">\n                  <div className={`h-full transition-all duration-1000 rounded-full ${isConnected ? \"bg-indigo-500 w-2/3 animate-pulse\" : \"bg-transparent w-0\"}`}></div>\n                </div>\n                <p className=\"text-slate-400 text-sm truncate\">\n                  System Context: <span className=\"text-white italic\">{isConnected ? \"Nexus OS Host Execution Enabled\" : \"Offline\"}</span>\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Status Labels */}\n        <div className=\"flex items-center justify-between mt-6 px-2 shrink-0\">\n          <div className=\"hidden sm:flex space-x-6 text-[10px] text-slate-500 uppercase tracking-widest font-bold\">\n            <span>Endpoint: API.GEMINI.GOOGLE.COM</span>\n            <span>Kernel: 6.5.0-GENERIC</span>\n            <span>Secure Mode: ENABLED</span>\n          </div>\n          <div className=\"text-[10px] text-slate-500 font-mono\">\n            {isConnected ? \"LISTENING > _\" : \"READY_FOR_INPUT > _\"}\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
