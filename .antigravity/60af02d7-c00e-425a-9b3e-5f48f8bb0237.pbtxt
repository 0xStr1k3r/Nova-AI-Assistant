      replacement_content: "        {/* Top System Bar */}\n        <div className=\"flex items-center justify-between mb-8 z-10 shrink-0 border-b border-white/5 pb-4\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"w-10 h-10 bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl flex items-center justify-center\">\n               <Terminal className=\"w-6 h-6 text-white\" />\n            </div>\n            <div>\n              <h1 className=\"text-lg font-bold tracking-tight uppercase\">Nexus Voice Core</h1>\n              <p className=\"text-xs text-slate-400 font-mono\">v2.0.4-LTS \342\200\242 sys_core</p>\n            </div>\n          </div>\n          <div className=\"hidden sm:flex space-x-2 items-center\">\n            \n            <button \n              onClick={toggleWakeWord}\n              className={`px-3 py-2 rounded-full border flex items-center space-x-2 transition-colors ${\n                 isWakeWordListening ? \"bg-indigo-500/20 border-indigo-500 text-indigo-400\" : \"bg-white/5 border-white/10 text-slate-400 hover:text-slate-300\"\n              }`}\n              title=\"Toggle Wake Word Background Listening\"\n            >\n              {isWakeWordListening ? <Mic size={14} className=\"animate-pulse\" /> : <MicOff size={14} />}\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">{isWakeWordListening ? \"Auto-Wake On\" : \"Auto-Wake Off\"}</span>\n            </button>\n\n            <div className=\"px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full flex items-center space-x-2\">\n              <div className={`w-2 h-2 rounded-full ${isConnected ? \"bg-emerald-400 animate-pulse\" : \"bg-neutral-500\"}`}></div>\n              <span className={`text-xs font-medium uppercase tracking-widest ${isConnected ? \"text-emerald-400\" : \"text-neutral-500\"}`}>\n                {isConnected ? \"Agent Online\" : \"Agent Offline\"}\n              </span>\n            </div>\n            \n            <button \n              onClick={() => setShowSettings(true)}\n              className=\"px-3 py-2 bg-white/5 backdrop-blur-md border border-white/10 rounded-full text-slate-300 hover:text-white transition-colors\"\n            >\n              <Settings size={16} />\n            </button>\n          </div>\n        </div>"
