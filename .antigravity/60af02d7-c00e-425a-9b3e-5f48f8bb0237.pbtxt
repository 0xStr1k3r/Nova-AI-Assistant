      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-screen bg-[#0A0A0A] text-[#E0E0E0] font-mono selection:bg-[#00FF41] selection:text-black flex flex-col items-center justify-center p-4\">\n      <div className=\"w-full max-w-4xl border border-[#333] rounded-lg overflow-hidden flex flex-col shadow-2xl relative\">\n        \n        {/* Title Bar */}\n        <div className=\"bg-[#1C1C1C] px-4 py-3 flex items-center justify-between border-b border-[#333]\">\n          <div className=\"flex items-center space-x-3\">\n            <Terminal className=\"text-[#00FF41]\" size={20} />\n            <span className=\"font-semibold tracking-wider text-sm uppercase\">Nexus OS Assistant</span>\n          </div>\n          <div className=\"flex space-x-4 text-xs text-neutral-500\">\n            <div className=\"flex items-center space-x-1.5\">\n              <Cpu size={14} /> <span>sys_core</span>\n            </div>\n            <div className=\"flex items-center space-x-1.5\">\n              <Activity size={14} /> <span>{isConnected ? \"online\" : \"offline\"}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Console / Visualization area */}\n        <div className=\"flex flex-col md:flex-row h-[600px]\">\n          \n          {/* Main Visualizer Area */}\n          <div className=\"flex-1 p-8 flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-[#333] relative overflow-hidden group\">\n            \n            <AnimatePresence>\n              {isConnected && (\n                <motion.div\n                  initial={{ opacity: 0, scale: 0.8 }}\n                  animate={{ opacity: 1, scale: 1 }}\n                  exit={{ opacity: 0, scale: 0.8 }}\n                  className=\"absolute inset-0 flex items-center justify-center pointer-events-none\"\n                >\n                  <div className=\"w-64 h-64 rounded-full bg-[#00FF41]/5 animate-pulse blur-3xl mix-blend-screen\" />\n                  <div className=\"w-48 h-48 rounded-full border border-[#00FF41]/20 absolute animate-[spin_10s_linear_infinite]\" />\n                  <div className=\"w-32 h-32 rounded-full border border-[#00FF41]/30 absolute animate-[spin_15s_linear_infinite_reverse]\" />\n                </motion.div>\n              )}\n            </AnimatePresence>\n\n            {/* Mic Button */}\n            <div className=\"z-10 relative\">\n              <motion.button\n                whileHover={{ scale: 1.05 }}\n                whileTap={{ scale: 0.95 }}\n                onClick={isConnected || isConnecting ? disconnect : connect}\n                className={`\n                  w-32 h-32 rounded-full flex items-center justify-center transition-all duration-500\n                  ${isConnected ? \"bg-[#1A1A1A] text-[#00FF41] shadow-[0_0_40px_rgba(0,255,65,0.2)] border border-[#00FF41]/50\" : \n                    isConnecting ? \"bg-neutral-800 text-yellow-500 border border-yellow-500/50 animate-pulse\" : \n                    \"bg-[#1A1A1A] text-neutral-400 hover:text-white border border-[#333] hover:border-[#555]\"}\n                `}\n              >\n                {isConnected ? (\n                  <Square size={36} fill=\"currentColor\" className=\"animate-pulse\" />\n                ) : isConnecting ? (\n                  <Activity size={36} className=\"animate-spin\" />\n                ) : (\n                  <Mic size={36} />\n                )}\n              </motion.button>\n            </div>\n\n            <div className=\"mt-12 text-center z-10 w-full px-8\">\n               <h2 className=\"text-xl font-bold tracking-widest uppercase mb-2\">\n                 {isConnected ? \"Awaiting Input\" : isConnecting ? \"Establishing Link...\" : \"System Standby\"}\n               </h2>\n               <p className=\"text-neutral-500 text-sm max-w-sm mx-auto\">\n                 {isConnected \n                  ? \"Speak your system commands. The assistant has host execution privileges.\"\n                  : \"Tap to connect to the Gemini intelligence core for system integration.\"}\n               </p>\n            </div>\n            \n          </div>\n\n          {/* Logs Panel */}\n          <div className=\"w-full md:w-80 bg-[#161616] p-4 flex flex-col\">\n            <div className=\"text-xs uppercase font-bold tracking-wider text-neutral-500 mb-4 pb-2 border-b border-[#333] flex items-center gap-2\">\n              <ShieldAlert size={14} className=\"text-yellow-600\" /> Event Horizon\n            </div>\n            <div className=\"flex-1 overflow-y-auto font-mono text-[11px] leading-relaxed text-neutral-400 space-y-1.5 scrollbar-thin\">\n              {logs.length === 0 ? (\n                <div className=\"flex flex-col items-center justify-center h-full text-neutral-600 opacity-50 space-y-2\">\n                  <CircleOff size={24} />\n                  <span>No events</span>\n                </div>\n              ) : (\n                logs.map((log, idx) => (\n                  <div key={idx} className={`${log.includes(\"ERROR\") || log.includes(\"Failed\") ? \"text-red-400\" : log.includes(\"Connected\") ? \"text-[#00FF41]\" : \"\"}`}>\n                    {log}\n                  </div>\n                ))\n              )}\n              <div ref={logsEndRef} />\n            </div>\n          </div>\n\n        </div>\n      </div>\n      \n      <div className=\"mt-8 text-neutral-600 text-xs w-full max-w-4xl text-center\">\n        Powered by Gemini Live API &middot; Use cautiously with root escalation commands.\n      </div>\n    </div>\n  );"
