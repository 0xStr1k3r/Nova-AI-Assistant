    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \"react\";\nimport { X, Save, Plus, Trash } from \"lucide-react\";\nimport { Mode, NexusConfig } from \"../../server/db\"; // Ensure we get similar types \n\ntype ConfigType = {\n  wakeWord: string;\n  activeModeId: string;\n  modes: Mode[];\n  memory: string[];\n};\n\nexport default function SettingsModal({\n  isOpen,\n  onClose,\n  config,\n  setConfig,\n}: {\n  isOpen: boolean;\n  onClose: () => void;\n  config: ConfigType | null;\n  setConfig: (cfg: ConfigType) => void;\n}) {\n  const [localConfig, setLocalConfig] = useState<ConfigType | null>(null);\n\n  useEffect(() => {\n    if (config) setLocalConfig(JSON.parse(JSON.stringify(config))); // clone\n  }, [config, isOpen]);\n\n  if (!isOpen || !localConfig) return null;\n\n  const handleSave = async () => {\n    try {\n      const res = await fetch(\"/api/config\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(localConfig),\n      });\n      if (res.ok) {\n        const body = await res.json();\n        setConfig(body.config);\n        onClose();\n      }\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const addCustomMode = () => {\n    const newMode: Mode = {\n      id: `custom-${Date.now()}`,\n      name: \"New Custom Mode\",\n      instruction: \"Custom instructions...\",\n      isCustom: true,\n    };\n    setLocalConfig({ ...localConfig, modes: [...localConfig.modes, newMode], activeModeId: newMode.id });\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-[#09090b] border border-white/10 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl relative overflow-hidden\">\n        {/* Modal Header */}\n        <div className=\"flex items-center justify-between p-6 border-b border-white/5 bg-white/5 backdrop-blur-xl\">\n          <h2 className=\"text-lg font-bold text-slate-100 uppercase tracking-widest\">System Configuration</h2>\n          <button onClick={onClose} className=\"text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer p-1 rounded-lg hover:bg-white/10\">\n            <X size={20} />\n          </button>\n        </div>\n\n        {/* Modal Content */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-8 scrollbar-thin\">\n          \n          {/* Wake Word Section */}\n          <div className=\"space-y-4\">\n            <h3 className=\"text-sm font-bold text-indigo-400 uppercase tracking-widest border-b border-white/5 pb-2\">Voice Activation</h3>\n            <div className=\"flex flex-col space-y-2\">\n              <label className=\"text-xs text-slate-400\">Wake Word (Triggers Active Listening)</label>\n              <input \n                type=\"text\" \n                value={localConfig.wakeWord}\n                onChange={(e) => setLocalConfig({...localConfig, wakeWord: e.target.value.toLowerCase()})}\n                className=\"bg-black/40 border border-white/10 rounded-lg px-4 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors w-full sm:w-1/2\"\n              />\n              <p className=\"text-[10px] text-slate-500\">The browser must be active/have permission for background listening.</p>\n            </div>\n          </div>\n\n          {/* Modes Section */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-white/5 pb-2\">\n               <h3 className=\"text-sm font-bold text-indigo-400 uppercase tracking-widest\">Operating Modes</h3>\n               <button onClick={addCustomMode} className=\"flex items-center space-x-1 text-xs text-emerald-400 hover:text-emerald-300\">\n                 <Plus size={14} /> <span>New Mode</span>\n               </button>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {localConfig.modes.map(mode => (\n                <div \n                  key={mode.id}\n                  onClick={() => setLocalConfig({...localConfig, activeModeId: mode.id})}\n                  className={`border rounded-xl p-4 cursor-pointer relative transition-all duration-300 ${\n                    localConfig.activeModeId === mode.id \n                    ? \"bg-indigo-500/10 border-indigo-500/50\" \n                    : \"bg-white/5 border-white/10 hover:bg-white/10\"\n                  }`}\n                >\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <h4 className={`font-bold text-sm ${localConfig.activeModeId === mode.id ? \"text-indigo-400\" : \"text-slate-300\"}`}>\n                      {mode.name}\n                    </h4>\n                    {mode.isCustom && (\n                      <button \n                        onClick={(e) => {\n                          e.stopPropagation();\n                          setLocalConfig({\n                            ...localConfig,\n                            modes: localConfig.modes.filter(m => m.id !== mode.id),\n                            activeModeId: localConfig.activeModeId === mode.id ? localConfig.modes[0].id : localConfig.activeModeId\n                          });\n                        }}\n                        className=\"text-red-400/50 hover:text-red-400 hover:bg-red-400/10 p-1 rounded\"\n                      >\n                        <Trash size={14} />\n                      </button>\n                    )}\n                  </div>\n                  \n                  {mode.isCustom ? (\n                    <div className=\"space-y-2 mt-2\" onClick={e => e.stopPropagation()}>\n                      <input \n                        type=\"text\" \n                        value={mode.name} \n                        onChange={(e) => {\n                          const newModes = localConfig.modes.map(m => m.id === mode.id ? {...m, name: e.target.value} : m);\n                          setLocalConfig({...localConfig, modes: newModes});\n                        }}\n                        className=\"bg-black/40 border border-white/10 rounded px-2 py-1 text-xs w-full text-white\"\n                      />\n                      <textarea \n                        value={mode.instruction}\n                        onChange={(e) => {\n                          const newModes = localConfig.modes.map(m => m.id === mode.id ? {...m, instruction: e.target.value} : m);\n                          setLocalConfig({...localConfig, modes: newModes});\n                        }}\n                        rows={3}\n                        className=\"bg-black/40 border border-white/10 rounded px-2 py-1 text-xs w-full text-slate-400 scrollbar-thin resize-none\"\n                      />\n                    </div>\n                  ) : (\n                    <p className=\"text-xs text-slate-500 line-clamp-3\">{mode.instruction}</p>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Memory Section */}\n          <div className=\"space-y-4\">\n             <h3 className=\"text-sm font-bold text-indigo-400 uppercase tracking-widest border-b border-white/5 pb-2\">System Memory</h3>\n             <div className=\"bg-black/40 border border-white/10 rounded-lg p-4 h-32 overflow-y-auto scrollbar-thin\">\n                {localConfig.memory.length === 0 ? (\n                  <p className=\"text-xs text-slate-500 italic\">No historical data recorded.</p>\n                ) : (\n                  localConfig.memory.map((m, i) => (\n                    <div key={i} className=\"text-[10px] font-mono text-slate-400 mb-1\">{m}</div>\n                  ))\n                )}\n             </div>\n             <button \n                onClick={() => setLocalConfig({...localConfig, memory: []})}\n                className=\"text-xs text-red-400/80 hover:text-red-400 border border-red-400/20 px-3 py-1.5 rounded-lg hover:bg-red-400/10 inline-flex items-center space-x-2\"\n             >\n               <Trash size={14} /> <span>Purge Memory</span>\n             </button>\n          </div>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 border-t border-white/5 bg-white/5 backdrop-blur-xl flex justify-end space-x-3\">\n          <button onClick={onClose} className=\"px-6 py-2 rounded-lg border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 text-sm font-medium transition-all\">Cancel</button>\n          <button onClick={handleSave} className=\"px-6 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white shadow-[0_0_15px_rgba(79,70,229,0.5)] text-sm font-bold flex items-center space-x-2 transition-all\">\n            <Save size={16} /> <span>Apply Config</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { X, Save, Plus, Trash } from \"lucide-react\";\n\nexport interface Mode {\n  id: string;\n  name: string;\n  instruction: string;\n  isCustom: boolean;\n}\n\nexport type ConfigType = {\n  wakeWord: string;\n  activeModeId: string;\n  modes: Mode[];\n  memory: string[];\n};\n\nexport default function SettingsModal({\n  isOpen,\n  onClose,\n  config,\n  setConfig,\n}: {\n  isOpen: boolean;\n  onClose: () => void;\n  config: ConfigType | null;\n  setConfig: (cfg: ConfigType) => void;\n}) {\n  const [localConfig, setLocalConfig] = useState<ConfigType | null>(null);\n\n  useEffect(() => {\n    if (config) setLocalConfig(JSON.parse(JSON.stringify(config))); // clone\n  }, [config, isOpen]);\n\n  if (!isOpen || !localConfig) return null;\n\n  const handleSave = async () => {\n    try {\n      const res = await fetch(\"/api/config\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(localConfig),\n      });\n      if (res.ok) {\n        const body = await res.json();\n        setConfig(body.config);\n        onClose();\n      }\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const addCustomMode = () => {\n    const newMode: Mode = {\n      id: `custom-${Date.now()}`,\n      name: \"New Custom Mode\",\n      instruction: \"Custom instructions...\",\n      isCustom: true,\n    };\n    setLocalConfig({ ...localConfig, modes: [...localConfig.modes, newMode], activeModeId: newMode.id });\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-[#09090b] border border-white/10 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl relative overflow-hidden\">\n        {/* Modal Header */}\n        <div className=\"flex items-center justify-between p-6 border-b border-white/5 bg-white/5 backdrop-blur-xl\">\n          <h2 className=\"text-lg font-bold text-slate-100 uppercase tracking-widest\">System Configuration</h2>\n          <button onClick={onClose} className=\"text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer p-1 rounded-lg hover:bg-white/10\">\n            <X size={20} />\n          </button>\n        </div>\n\n        {/* Modal Content */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-8 scrollbar-thin\">\n          \n          {/* Wake Word Section */}\n          <div className=\"space-y-4\">\n            <h3 className=\"text-sm font-bold text-indigo-400 uppercase tracking-widest border-b border-white/5 pb-2\">Voice Activation</h3>\n            <div className=\"flex flex-col space-y-2\">\n              <label className=\"text-xs text-slate-400\">Wake Word (Triggers Active Listening)</label>\n              <input \n                type=\"text\" \n                value={localConfig.wakeWord}\n                onChange={(e) => setLocalConfig({...localConfig, wakeWord: e.target.value.toLowerCase()})}\n                className=\"bg-black/40 border border-white/10 rounded-lg px-4 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors w-full sm:w-1/2\"\n              />\n              <p className=\"text-[10px] text-slate-500\">The browser must be active/have permission for background listening.</p>\n            </div>\n          </div>\n\n          {/* Modes Section */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-white/5 pb-2\">\n               <h3 className=\"text-sm font-bold text-indigo-400 uppercase tracking-widest\">Operating Modes</h3>\n               <button onClick={addCustomMode} className=\"flex items-center space-x-1 text-xs text-emerald-400 hover:text-emerald-300\">\n                 <Plus size={14} /> <span>New Mode</span>\n               </button>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {localConfig.modes.map(mode => (\n                <div \n                  key={mode.id}\n                  onClick={() => setLocalConfig({...localConfig, activeModeId: mode.id})}\n                  className={`border rounded-xl p-4 cursor-pointer relative transition-all duration-300 ${\n                    localConfig.activeModeId === mode.id \n                    ? \"bg-indigo-500/10 border-indigo-500/50\" \n                    : \"bg-white/5 border-white/10 hover:bg-white/10\"\n                  }`}\n                >\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <h4 className={`font-bold text-sm ${localConfig.activeModeId === mode.id ? \"text-indigo-400\" : \"text-slate-300\"}`}>\n                      {mode.name}\n                    </h4>\n                    {mode.isCustom && (\n                      <button \n                        onClick={(e) => {\n                          e.stopPropagation();\n                          setLocalConfig({\n                            ...localConfig,\n                            modes: localConfig.modes.filter(m => m.id !== mode.id),\n                            activeModeId: localConfig.activeModeId === mode.id ? localConfig.modes[0].id : localConfig.activeModeId\n                          });\n                        }}\n                        className=\"text-red-400/50 hover:text-red-400 hover:bg-red-400/10 p-1 rounded\"\n                      >\n                        <Trash size={14} />\n                      </button>\n                    )}\n                  </div>\n                  \n                  {mode.isCustom ? (\n                    <div className=\"space-y-2 mt-2\" onClick={e => e.stopPropagation()}>\n                      <input \n                        type=\"text\" \n                        value={mode.name} \n                        onChange={(e) => {\n                          const newModes = localConfig.modes.map(m => m.id === mode.id ? {...m, name: e.target.value} : m);\n                          setLocalConfig({...localConfig, modes: newModes});\n                        }}\n                        className=\"bg-black/40 border border-white/10 rounded px-2 py-1 text-xs w-full text-white\"\n                      />\n                      <textarea \n                        value={mode.instruction}\n                        onChange={(e) => {\n                          const newModes = localConfig.modes.map(m => m.id === mode.id ? {...m, instruction: e.target.value} : m);\n                          setLocalConfig({...localConfig, modes: newModes});\n                        }}\n                        rows={3}\n                        className=\"bg-black/40 border border-white/10 rounded px-2 py-1 text-xs w-full text-slate-400 scrollbar-thin resize-none\"\n                      />\n                    </div>\n                  ) : (\n                    <p className=\"text-xs text-slate-500 line-clamp-3\">{mode.instruction}</p>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Memory Section */}\n          <div className=\"space-y-4\">\n             <h3 className=\"text-sm font-bold text-indigo-400 uppercase tracking-widest border-b border-white/5 pb-2\">System Memory</h3>\n             <div className=\"bg-black/40 border border-white/10 rounded-lg p-4 h-32 overflow-y-auto scrollbar-thin\">\n                {localConfig.memory.length === 0 ? (\n                  <p className=\"text-xs text-slate-500 italic\">No historical data recorded.</p>\n                ) : (\n                  localConfig.memory.map((m, i) => (\n                    <div key={i} className=\"text-[10px] font-mono text-slate-400 mb-1\">{m}</div>\n                  ))\n                )}\n             </div>\n             <button \n                onClick={() => setLocalConfig({...localConfig, memory: []})}\n                className=\"text-xs text-red-400/80 hover:text-red-400 border border-red-400/20 px-3 py-1.5 rounded-lg hover:bg-red-400/10 inline-flex items-center space-x-2\"\n             >\n               <Trash size={14} /> <span>Purge Memory</span>\n             </button>\n          </div>\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"p-4 border-t border-white/5 bg-white/5 backdrop-blur-xl flex justify-end space-x-3\">\n          <button onClick={onClose} className=\"px-6 py-2 rounded-lg border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 text-sm font-medium transition-all\">Cancel</button>\n          <button onClick={handleSave} className=\"px-6 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white shadow-[0_0_15px_rgba(79,70,229,0.5)] text-sm font-bold flex items-center space-x-2 transition-all\">\n            <Save size={16} /> <span>Apply Config</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
