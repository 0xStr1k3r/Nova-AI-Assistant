    instruction: "Update server.ts to use DB hooks, add REST endpoints for settings, and inject current mode instruction and memory into Gemini system instruction."
    replacement_infos {
      original_chunk {
        target_content: "import express from \"express\";\nimport path from \"path\";\nimport http from \"http\";\nimport { WebSocketServer } from \"ws\";\nimport { GoogleGenAI, LiveServerMessage, Modality, Type } from \"@google/genai\";\nimport { createServer as createViteServer } from \"vite\";\nimport { exec } from \"child_process\";\nimport util from \"util\";\n\nconst execAsync = util.promisify(exec);\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  // Create standard HTTP server\n  const server = http.createServer(app);\n\n  // Set up WebSocket server for Gemini Live API\n  const wss = new WebSocketServer({ server, path: \"/live\" });\n\n  const ai = new GoogleGenAI({\n    apiKey: process.env.GEMINI_API_KEY,\n    httpOptions: {\n      headers: {\n        \"User-Agent\": \"aistudio-build\",\n      },\n    },\n  });\n\n  wss.on(\"connection\", async (clientWs) => {\n    let session: any = null;\n\n    try {\n      session = await ai.live.connect({\n        model: \"gemini-3.1-flash-live-preview\",\n        callbacks: {\n          onmessage: async (message: LiveServerMessage) => {\n            const audio =\n              message.serverContent?.modelTurn?.parts?.[0]?.inlineData?.data;\n            if (audio) {\n              clientWs.send(JSON.stringify({ audio }));\n            }\n            if (message.serverContent?.interrupted) {\n              clientWs.send(JSON.stringify({ interrupted: true }));\n            }\n\n            // Handle toolCall requests from Gemini\n            const toolCalls = message.toolCall?.functionCalls;\n            if (toolCalls && toolCalls.length > 0) {\n              const toolResponses: any[] = [];\n\n              for (const call of toolCalls) {\n                if (call.name === \"runLinuxCommand\") {\n                  const cmdArgs = call.args as any;\n                  const command = cmdArgs.command as string;\n                  let resultStr = \"\";\n                  try {\n                    // For security, limit output size and add timeout\n                    const { stdout, stderr } = await execAsync(command, { timeout: 10000, maxBuffer: 1024 * 1024 });\n                    resultStr = `STDOUT:\\n${stdout}\\nSTDERR:\\n${stderr}`.trim();\n                  } catch (error: any) {\n                    resultStr = `ERROR:\\n${error.message}\\nSTDOUT:\\n${error.stdout}\\nSTDERR:\\n${error.stderr}`.trim();\n                  }\n                  \n                  // Truncate to reasonable size so we don\'t blow up context limit\n                  if (resultStr.length > 2000) {\n                    resultStr = resultStr.substring(0, 2000) + \"\\n...[TRUNCATED]\";\n                  }\n\n                  toolResponses.push({\n                    id: call.id,\n                    name: call.name,\n                    response: { result: resultStr },\n                  });\n                }\n              }\n\n              if (toolResponses.length > 0) {\n                // Return tool outputs\n                session.sendToolResponse({\n                  functionResponses: toolResponses,\n                });\n              }\n            }\n          },\n        },\n        config: {\n          responseModalities: [Modality.AUDIO],\n          speechConfig: {\n            voiceConfig: { prebuiltVoiceConfig: { voiceName: \"Zephyr\" } },\n          },\n          systemInstruction: `You are an AI system assistant. Your purpose is to help the user control and introspect their Linux system. You can execute bash operations using the \'runLinuxCommand\' tool. Only run safe non-destructive commands unless explicitly asked. Present results concisely via voice. If an command output is large, summarize the important parts.\nEnvironment limits: This app runs in a dockerized/sandboxed container if hosted online. If the user runs it natively, it will have their normal host access.`,\n          tools: [\n            {\n              functionDeclarations: [\n                {\n                  name: \"runLinuxCommand\",\n                  description: \"Executes a shell command on the underlying Linux host and returns the stdout and stderr.\",\n                  parameters: {\n                    type: Type.OBJECT,\n                    properties: {\n                      command: {\n                        type: Type.STRING,\n                        description: \"The shell command to run (e.g. \'ls -la\', \'free -m\', \'cat /etc/os-release\')\",\n                      },\n                    },\n                    required: [\"command\"],\n                  },\n                },\n              ],\n            },\n          ],\n        },\n      });\n    } catch (e) {\n      console.error(\"Gemini connection error:\", e);\n      clientWs.close();\n      return;\n    }\n\n    clientWs.on(\"message\", (data) => {\n      try {\n        const payload = JSON.parse(data.toString());\n        if (payload.audio && session) {\n          session.sendRealtimeInput({\n            audio: { data: payload.audio, mimeType: \"audio/pcm;rate=16000\" },\n          });\n        }\n      } catch (err) {\n        console.error(\"Audio processing error\", err);\n      }\n    });\n\n    clientWs.on(\"close\", () => {\n      // close gemini session gracefully?\n      // In SDK \'session\' doesn\'t seem to have a close method directly except discarding.\n    });\n  });\n\n  // API route example (if needed)\n  app.get(\"/api/health\", (req, res) => {\n    res.json({ status: \"ok\" });\n  });\n\n  // Vite middleware for development\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  server.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();"
        replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport http from \"http\";\nimport { WebSocketServer } from \"ws\";\nimport { GoogleGenAI, LiveServerMessage, Modality, Type } from \"@google/genai\";\nimport { createServer as createViteServer } from \"vite\";\nimport { exec } from \"child_process\";\nimport util from \"util\";\nimport { getDb, saveDb, addMemory, NexusConfig } from \"./src/server/db\";\n\nconst execAsync = util.promisify(exec);\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  app.use(express.json());\n\n  // Create standard HTTP server\n  const server = http.createServer(app);\n\n  // Set up WebSocket server for Gemini Live API\n  const wss = new WebSocketServer({ server, path: \"/live\" });\n\n  const ai = new GoogleGenAI({\n    apiKey: process.env.GEMINI_API_KEY,\n    httpOptions: {\n      headers: {\n        \"User-Agent\": \"aistudio-build\",\n      },\n    },\n  });\n\n  wss.on(\"connection\", async (clientWs) => {\n    let session: any = null;\n    const db = getDb();\n    const activeMode = db.modes.find(m => m.id === db.activeModeId) || db.modes[0];\n    \n    // Inject memory into system context\n    const memoryContext = db.memory.length > 0 \n      ? `\\n\\nPAST MEMORY/CONTEXT:\\n${db.memory.join(\'\\n\')}`\n      : \"\";\n\n    try {\n      session = await ai.live.connect({\n        model: \"gemini-3.1-flash-live-preview\",\n        callbacks: {\n          onmessage: async (message: LiveServerMessage) => {\n            const audio =\n              message.serverContent?.modelTurn?.parts?.[0]?.inlineData?.data;\n            if (audio) {\n              clientWs.send(JSON.stringify({ audio }));\n            }\n            if (message.serverContent?.interrupted) {\n              clientWs.send(JSON.stringify({ interrupted: true }));\n            }\n\n            // Handle toolCall requests from Gemini\n            const toolCalls = message.toolCall?.functionCalls;\n            if (toolCalls && toolCalls.length > 0) {\n              const toolResponses: any[] = [];\n\n              for (const call of toolCalls) {\n                if (call.name === \"runLinuxCommand\") {\n                  const cmdArgs = call.args as any;\n                  const command = cmdArgs.command as string;\n                  let resultStr = \"\";\n                  try {\n                    // For security, limit output size and add timeout\n                    const { stdout, stderr } = await execAsync(command, { timeout: 10000, maxBuffer: 1024 * 1024 });\n                    resultStr = `STDOUT:\\n${stdout}\\nSTDERR:\\n${stderr}`.trim();\n                    addMemory(`Executed command: ${command}`);\n                  } catch (error: any) {\n                    resultStr = `ERROR:\\n${error.message}\\nSTDOUT:\\n${error.stdout}\\nSTDERR:\\n${error.stderr}`.trim();\n                    addMemory(`Failed command: ${command}`);\n                  }\n                  \n                  // Truncate to reasonable size so we don\'t blow up context limit\n                  if (resultStr.length > 2000) {\n                    resultStr = resultStr.substring(0, 2000) + \"\\n...[TRUNCATED]\";\n                  }\n\n                  toolResponses.push({\n                    id: call.id,\n                    name: call.name,\n                    response: { result: resultStr },\n                  });\n                }\n              }\n\n              if (toolResponses.length > 0) {\n                // Return tool outputs\n                session.sendToolResponse({\n                  functionResponses: toolResponses,\n                });\n              }\n            }\n          },\n        },\n        config: {\n          responseModalities: [Modality.AUDIO],\n          speechConfig: {\n            voiceConfig: { prebuiltVoiceConfig: { voiceName: \"Zephyr\" } },\n          },\n          systemInstruction: `You are a Voice Assistant. ${activeMode.instruction}\\nEnvironment: Linux. ${memoryContext}`,\n          tools: [\n            {\n              functionDeclarations: [\n                {\n                  name: \"runLinuxCommand\",\n                  description: \"Executes a shell command on the underlying Linux host and returns the stdout and stderr.\",\n                  parameters: {\n                    type: Type.OBJECT,\n                    properties: {\n                      command: {\n                        type: Type.STRING,\n                        description: \"The shell command to run.\",\n                      },\n                    },\n                    required: [\"command\"],\n                  },\n                },\n              ],\n            },\n          ],\n        },\n      });\n    } catch (e) {\n      console.error(\"Gemini connection error:\", e);\n      clientWs.close();\n      return;\n    }\n\n    clientWs.on(\"message\", (data) => {\n      try {\n        const payload = JSON.parse(data.toString());\n        if (payload.audio && session) {\n          session.sendRealtimeInput({\n            audio: { data: payload.audio, mimeType: \"audio/pcm;rate=16000\" },\n          });\n        }\n      } catch (err) {\n        console.error(\"Audio processing error\", err);\n      }\n    });\n\n    clientWs.on(\"close\", () => {\n    });\n  });\n\n  // Settings API\n  app.get(\"/api/config\", (req, res) => {\n    res.json(getDb());\n  });\n\n  app.post(\"/api/config\", (req, res) => {\n    const db = getDb();\n    const newConfig: NexusConfig = { ...db, ...req.body };\n    saveDb(newConfig);\n    res.json({ success: true, config: newConfig });\n  });\n\n  app.post(\"/api/memory\", (req, res) => {\n    const { entry } = req.body;\n    if (entry) {\n       addMemory(entry);\n    }\n    res.json({ success: true });\n  });\n\n  // Vite middleware for development\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  server.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();"
      }
      num_matches: 1
    }
  }
}
